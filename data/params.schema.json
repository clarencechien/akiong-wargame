{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "akiong-wargame 參數庫",
  "type": "object",
  "required": ["version", "params"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "note": { "type": "string" },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "value", "range", "unit", "source", "assumption"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+(\\.[A-Za-z0-9]+)+$", "description": "群.名稱[.子鍵]，群 ∈ weather/lift/detect/fire/gate/cross/beach/regional/world/home/inland/aux" },
          "label": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "unit": { "type": "string" },
          "source": { "type": "string", "minLength": 4, "description": "出處；不可寫「同上」" },
          "note": { "type": "string" },
          "assumption": { "type": "boolean", "description": "true = 來源不足或模型結構假設，UI 顯示「模型假設」" }
        }
      }
    }
  }
}
